# SMTP Configuration for RUDI Platform
# ========================================
#
# Copy this file to .env.smtp and configure with your SMTP provider credentials
# This file should NOT be committed to version control
#
# Usage:
#   1. Copy: cp .env.smtp.example .env.smtp
#   2. Edit .env.smtp with your SMTP provider details
#   3. Source it before deployment: source .env.smtp
#
# The prepare-properties.sh script will read these variables and inject them
# into the microservice properties files.

# SMTP Server Configuration
# ========================================

# SMTP Host (your email server)
# Examples:
#   - Gmail: smtp.gmail.com
#   - Office365: smtp.office365.com
#   - SendGrid: smtp.sendgrid.net
#   - Amazon SES: email-smtp.us-east-1.amazonaws.com
#   - Mailgun: smtp.mailgun.org
#   - Local/Testing: mailhog (if using docker mailhog)
SMTP_HOST=smtp.gmail.com

# SMTP Port
# Common values:
#   - 25:  Unencrypted (not recommended)
#   - 587: STARTTLS (recommended)
#   - 465: SSL/TLS
#   - 1025: Mailhog (testing)
SMTP_PORT=587

# SMTP Authentication
# Set to true if your SMTP server requires authentication
# Most production SMTP servers require this
SMTP_AUTH=true

# SMTP STARTTLS
# Enable STARTTLS encryption (recommended for port 587)
SMTP_STARTTLS=true

# SMTP Credentials
# ========================================

# SMTP Username
# This is usually your email address or API key
# Examples:
#   - Gmail: your-email@gmail.com
#   - SendGrid: apikey
#   - Amazon SES: your-iam-smtp-username
SMTP_USERNAME=your-email@example.com

# SMTP Password
# WARNING: Keep this secure! Never commit this file with real credentials
# Examples:
#   - Gmail: App-specific password (not your regular password)
#   - SendGrid: Your API key
#   - Amazon SES: Your IAM SMTP password
SMTP_PASSWORD=your-smtp-password-here

# From Address
# ========================================

# The email address that will appear in the "From" field
# This should be an address allowed by your SMTP provider
SMTP_FROM=noreply@yourdomain.com

# ========================================
# Provider-Specific Examples
# ========================================

# Example 1: Gmail (with App Password)
# ----------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com
#
# Note: You must enable 2FA and create an App Password:
# https://support.google.com/accounts/answer/185833

# Example 2: Office 365
# ----------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USERNAME=your-email@company.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=your-email@company.com

# Example 3: SendGrid
# ----------------------------------------
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=SG.your-sendgrid-api-key
# SMTP_FROM=noreply@yourdomain.com

# Example 4: Amazon SES
# ----------------------------------------
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# SMTP_USERNAME=your-iam-smtp-username
# SMTP_PASSWORD=your-iam-smtp-password
# SMTP_FROM=noreply@verified-domain.com
#
# Note: Your from address must be verified in SES

# Example 5: Mailhog (Local Testing)
# ----------------------------------------
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_AUTH=false
# SMTP_STARTTLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=test@localhost

# ========================================
# Testing Your Configuration
# ========================================
#
# After configuration, test with:
#   docker exec acl curl -X POST http://localhost:8443/test-email
#
# Check logs:
#   docker compose logs acl | grep -i mail
#
# ========================================
