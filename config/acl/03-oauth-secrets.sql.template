-- 03-oauth-secrets.sql
--
-- Updates microservice user passwords in acl_data.user_ to match the
-- generated MS_* secrets in .env.
--
-- This script is NOT part of docker-entrypoint-initdb.d/ — it is run by
-- deploy.sh AFTER ACL has started and Flyway has populated acl_data.user_.
--
-- The Flyway migrations inside the ACL jar seed each microservice user with
-- an unknown hardcoded BCrypt hash. This script overwrites those hashes with
-- the deployment-specific generated secrets so that each service's
-- module.oauth2.client-secret property matches what ACL has in its database.

CREATE EXTENSION IF NOT EXISTS pgcrypto;

UPDATE acl_data.user_ SET password = crypt('${MS_ACL}',        gen_salt('bf')) WHERE login = 'acl';
UPDATE acl_data.user_ SET password = crypt('${MS_APIGATEWAY}', gen_salt('bf')) WHERE login = 'apigateway';
UPDATE acl_data.user_ SET password = crypt('${MS_KALIM}',      gen_salt('bf')) WHERE login = 'kalim';
UPDATE acl_data.user_ SET password = crypt('${MS_KONSENT}',    gen_salt('bf')) WHERE login = 'konsent';
UPDATE acl_data.user_ SET password = crypt('${MS_KOS}',        gen_salt('bf')) WHERE login = 'kos';
UPDATE acl_data.user_ SET password = crypt('${MS_KONSULT}',    gen_salt('bf')) WHERE login = 'konsult';
UPDATE acl_data.user_ SET password = crypt('${MS_PROJEKT}',    gen_salt('bf')) WHERE login = 'projekt';
UPDATE acl_data.user_ SET password = crypt('${MS_SELFDATA}',   gen_salt('bf')) WHERE login = 'selfdata';
UPDATE acl_data.user_ SET password = crypt('${MS_STRUKTURE}',  gen_salt('bf')) WHERE login = 'strukture';
