# ============================================================
# RUDI Out-of-the-Box — Configuration
#
# Copier ce fichier en .env et remplir les valeurs :
#   cp .env.example .env
#
# Le fichier .env sera complété automatiquement par
# generate-passwords.sh avec tous les secrets générés.
# Ne pas committer .env — il contient des données sensibles.
# ============================================================

# Domaine de base. Les services seront exposés sous
# rudi.<base_dn>, dataverse.<base_dn>, magnolia.<base_dn>
base_dn=mondomaine.fr

# Version de la plateforme RUDI
rudi_version=v3.3.13

# Version de Dataverse (image gdcc/dataverse et gdcc/configbaker)
dataverse_version=6.9-noble

# Email pour les certificats Let's Encrypt (Traefik)
LETSENCRYPT_EMAIL=admin@mondomaine.fr

# Image rudinode du nœud producteur
# Miroir disponible : ghcr.io/rudi-platform/rudinode
rudinode_image=registry.aqmo.org/public-rudi/public-packages/rudinode
rudinode_version=latest
