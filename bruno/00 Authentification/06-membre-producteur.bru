meta {
  name: Se connecter (membre de l'organisation productrice)
  type: http
  seq: 6
}

post {
  url: {{protocol}}://{{host}}/authenticate
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  login: {{process.env.MEMBER_LOGIN}}
  password: {{process.env.MEMBER_PASSWORD}}
}

script:post-response {
  if (res.status === 200 && res.body && res.body.jwtToken) {
    bru.setVar("jwtToken", res.body.jwtToken.replace(/^Bearer /, ""));
    bru.setVar("jwtRole", "membre");
  }
}

tests {
  test("connexion acceptée", function () {
    expect(res.status).to.equal(200);
    expect(res.body.jwtToken).to.be.a("string");
  });
}

docs {
  Membre de l'organisation productrice d'un jeu de données restreint : accepte ou refuse les demandes d'accès.
}
