meta {
  name: Se connecter (administrateur)
  type: http
  seq: 1
}

post {
  url: {{protocol}}://{{host}}/authenticate
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  login: {{process.env.ADMIN_LOGIN}}
  password: {{process.env.ADMIN_PASSWORD}}
}

script:post-response {
  if (res.status === 200 && res.body && res.body.jwtToken) {
    bru.setVar("jwtToken", res.body.jwtToken.replace(/^Bearer /, ""));
    bru.setVar("jwtRole", "administrateur");
  }
}

tests {
  test("connexion acceptée", function () {
    expect(res.status).to.equal(200);
    expect(res.body.jwtToken).to.be.a("string");
  });
}

docs {
  Compte administrateur du portail (ADMIN_LOGIN / ADMIN_PASSWORD de .env).
}
