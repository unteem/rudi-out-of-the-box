meta {
  name: Refuser (au lieu d'accepter)
  type: http
  seq: 1
}

put {
  url: {{protocol}}://{{host}}/strukture/v1/organizations/tasks/{{taskId}}/do-it/refused
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/02-animateur");
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : animateur (connexion automatique avant la requête).

  Alternative à « Accepter ». Pour joindre un message, compléter la tâche (PUT .../tasks) avant.
}
