meta {
  name: Relâcher la tâche (sans la traiter)
  type: http
  seq: 2
}

put {
  url: {{protocol}}://{{host}}/strukture/v1/organizations/tasks/{{taskId}}/unclaim
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/02-animateur");
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : animateur (connexion automatique avant la requête).

  Rend la tâche à nouveau disponible pour les autres animateurs.
}
