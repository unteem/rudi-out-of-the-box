meta {
  name: Rechercher des organisations du portail (vue du nœud)
  type: http
  seq: 6
}

get {
  url: {{protocol}}://{{host}}/node/v1/organizations/request?name={{process.env.ORGANIZATION_NAME}}
  body: none
  auth: inherit
}

params:query {
  name: {{process.env.ORGANIZATION_NAME}}
}

script:pre-request {
  await bru.runRequest("00 Authentification/04-noeud-robot");
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : nœud producteur (connexion automatique avant la requête).

  Recherche utilisée par le manager du nœud pour choisir l'organisation à rattacher (par nom ou uuid).
}
