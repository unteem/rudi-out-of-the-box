put {
  url: {{protocol}}://{{host}}/strukture/v1/organizations/tasks/{{taskId}}/claim
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/02-animateur");
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : animateur (connexion automatique avant la requête).

  La tâche doit être prise (claim) par le compte qui la traite.
}
