meta {
  name: Une demande est-elle en cours ? (vue du nœud)
  type: http
  seq: 2
}

get {
  url: {{protocol}}://{{host}}/node/v1/linked-producers/request/{{organizationUuid}}/hasTask
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/04-noeud-robot");
  if (!bru.getVar("organizationUuid") && bru.getProcessEnv("ORGANIZATION_UUID")) { bru.setVar("organizationUuid", bru.getProcessEnv("ORGANIZATION_UUID")); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : nœud producteur (connexion automatique avant la requête).
}
