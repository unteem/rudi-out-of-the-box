meta {
  name: Trouver la tâche (demande de détachement)
  type: http
  seq: 2
}

get {
  url: {{protocol}}://{{host}}/strukture/v1/tasks?process-definition-keys=linked-producer-process
  body: none
  auth: inherit
}

params:query {
  process-definition-keys: linked-producer-process
}

script:pre-request {
  await bru.runRequest("00 Authentification/02-animateur");
  bru.setVar("taskId", null);
}

script:post-response {
  const target = bru.getVar("linkedProducerUuid");
  const tasks = Array.isArray(res.body) ? res.body : [];
  const task = tasks.find(function (t) {
    const a = t.asset || {};
    return a.uuid === target || (a.organization && a.organization.uuid === target);
  });
  if (task) {
    bru.setVar("taskId", task.id);
  }
}

tests {
  test("tâche trouvée", function () {
    expect(res.status).to.equal(200);
    expect(bru.getVar("taskId"), "aucune tâche en attente pour cet objet").to.be.a("string");
  });
}

docs {
  Compte : animateur (connexion automatique avant la requête).

  Tâches linked-producer-process visibles par l'animateur ; retient celle de {{linkedProducerUuid}} dans taskId (visible aussi dans « Mes notifications » du portail).
}
