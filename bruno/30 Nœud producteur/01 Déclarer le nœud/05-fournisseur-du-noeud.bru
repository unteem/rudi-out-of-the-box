meta {
  name: Retrouver le fournisseur d'un nœud
  type: http
  seq: 5
}

get {
  url: {{protocol}}://{{host}}/strukture/v1/providers?nodeProviderUuids={{nodeUuid}}&full=true
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/01-administrateur");
  if (!bru.getVar("nodeUuid") && bru.getProcessEnv("NODE_LOGIN")) { bru.setVar("nodeUuid", bru.getProcessEnv("NODE_LOGIN")); }
}

script:post-response {
  if (res.status === 200 && res.body.elements && res.body.elements.length) { bru.setVar("providerUuid", res.body.elements[0].uuid); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : administrateur (connexion automatique avant la requête).

  Recherche par UUID de nœud ; renseigne providerUuid.
}
