meta {
  name: Ajouter une adresse e-mail au fournisseur
  type: http
  seq: 7
}

post {
  url: {{protocol}}://{{host}}/strukture/v1/providers/{{providerUuid}}/addresses
  body: json
  auth: inherit
}

body:json {
  {
    "type": "EMAIL",
    "email": "{{process.env.PRODUCER_EMAIL}}"
  }
}

script:pre-request {
  await bru.runRequest("00 Authentification/01-administrateur");
  if (!bru.getVar("providerUuid") && bru.getProcessEnv("PROVIDER_UUID")) { bru.setVar("providerUuid", bru.getProcessEnv("PROVIDER_UUID")); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : administrateur (connexion automatique avant la requête).

  Type d'adresse EMAIL ; un rôle d'adresse (addressRole) peut être précisé, voir « 20 Organisations ».
}
