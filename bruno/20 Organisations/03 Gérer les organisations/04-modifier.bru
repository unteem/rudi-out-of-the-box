meta {
  name: Modifier une organisation
  type: http
  seq: 4
}

put {
  url: {{protocol}}://{{host}}/strukture/v1/organizations
  body: json
  auth: inherit
}

body:json {
  {}
}

script:pre-request {
  await bru.runRequest("00 Authentification/01-administrateur");
  function needJson(name) {
    const v = bru.getVar(name);
    if (!v) { throw new Error("Variable " + name + " absente : exécuter d'abord les étapes précédentes du dossier"); }
    return JSON.parse(v);
  }
  const org = needJson("organizationJson"));
  org.description = org.description + " (modifiée)";
  req.setBody(org);
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : administrateur (connexion automatique avant la requête).

  Renvoie l'organisation lue par « Consulter une organisation », description modifiée.
}
