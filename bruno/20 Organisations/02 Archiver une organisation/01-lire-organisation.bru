meta {
  name: Lire l'organisation
  type: http
  seq: 1
}

get {
  url: {{protocol}}://{{host}}/strukture/v1/organizations/{{organizationUuid}}
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/03-utilisateur");
  if (!bru.getVar("organizationUuid") && bru.getProcessEnv("ORGANIZATION_UUID")) { bru.setVar("organizationUuid", bru.getProcessEnv("ORGANIZATION_UUID")); }
}

script:post-response {
  if (res.status === 200) { bru.setVar("organizationJson", JSON.stringify(res.body)); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : utilisateur (connexion automatique avant la requête).
}
