meta {
  name: Formulaire d'archivage
  type: http
  seq: 2
}

get {
  url: {{protocol}}://{{host}}/strukture/v1/organizations/tasks/draft-form?form-type=DRAFT_ARCHIVE
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/03-utilisateur");
}

script:post-response {
  if (res.status === 200) { bru.setVar("archiveForm", JSON.stringify(res.body)); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : utilisateur (connexion automatique avant la requête).
}
