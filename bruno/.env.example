# Copier en .env (ignoré par git) et compléter.

# Portail RUDI et nœud producteur
RUDI_HOST=rudi.mondomaine.fr
PRODUCER_HOST=producteur.mondomaine.fr

# Administrateur du portail (rôles ADMINISTRATOR et MODERATOR)
ADMIN_LOGIN=admin@mondomaine.fr
ADMIN_PASSWORD=

# Animateur (rôle MODERATOR) : valide les demandes d'organisation, de
# rattachement et de réutilisation. Peut être le même compte que l'administrateur.
ANIMATEUR_LOGIN=admin@mondomaine.fr
ANIMATEUR_PASSWORD=

# Utilisateur du portail (réutilisateur), créé via « Créer un compte »
USER_LOGIN=
USER_PASSWORD=
# Changement / réinitialisation de mot de passe (« 10 Comptes »)
USER_NEW_PASSWORD=
PASSWORD_RESET_TOKEN=
# Rôle ajouté par « Ajouter un rôle à un utilisateur »
ROLE_TO_ADD=MODERATOR

# Membre de l'organisation productrice (rôle EDITOR ou ADMINISTRATOR dans
# l'organisation) : traite les demandes d'accès aux jeux restreints
MEMBER_LOGIN=
MEMBER_PASSWORD=

# Compte ROBOT du nœud producteur : PRODUCER_NODE_UUID et PRODUCER_PASSWORD
# du .env du dépôt. NODE_LOGIN est aussi l'UUID du nœud.
NODE_LOGIN=
NODE_PASSWORD=

# ─── Données des workflows ──────────────────────────────────────────────────
# Utilisées à la création (fournisseur, organisation…)
PRODUCER_CODE=mon-producteur
PRODUCER_LABEL=Mon producteur
PRODUCER_EMAIL=contact@mondomaine.fr
ORGANIZATION_NAME=Mon organisation
# Jeu de données de test (« 40 Jeux de données ») : codes KOS
DATASET_TITLE=Jeu de données de test
DATASET_THEME=economy
DATASET_LICENCE=etalab-2.0
# Réutilisation de test (« 50 Réutilisations »)
PROJECT_TITLE=Réutilisation de test
# Archivage d'organisation : ARCHIVED (réutilisations visibles) ou DISENGAGED
ARCHIVE_MODE=ARCHIVED

# Objets existants (facultatif) : reprises quand une requête est lancée seule,
# sans l'étape qui les crée. Ex. ORGANIZATION_UUID pour rattacher une
# organisation déjà validée. PROVIDER_UUID : PRODUCER_PROVIDER_UUID du dépôt.
PROVIDER_UUID=
ORGANIZATION_UUID=
LINKED_PRODUCER_UUID=
USER_UUID=
PROJECT_UUID=
DATASET_GLOBAL_ID=
DATASET_MEDIA_ID=
LINKED_DATASET_UUID=
NEW_DATASET_REQUEST_UUID=
