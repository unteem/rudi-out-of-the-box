meta {
  name: Consulter la réutilisation
  type: http
  seq: 16
}

get {
  url: {{protocol}}://{{host}}/projekt/v1/projects/{{projectUuid}}
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("00 Authentification/03-utilisateur");
  if (!bru.getVar("projectUuid") && bru.getProcessEnv("PROJECT_UUID")) { bru.setVar("projectUuid", bru.getProcessEnv("PROJECT_UUID")); }
}

script:post-response {
  if (res.status === 200) { bru.setVar("projectJson", JSON.stringify(res.body)); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : utilisateur (connexion automatique avant la requête).

  project_status VALIDATED et status COMPLETED une fois la publication acceptée.
}
