meta {
  name: Mobiliser un jeu de données ouvert
  type: http
  seq: 10
}

post {
  url: {{protocol}}://{{host}}/projekt/v1/projects/{{projectUuid}}/linked-datasets
  body: json
  auth: inherit
}

body:json {
  {
    "object_type": "LinkedDataset",
    "dataset_uuid": "{{globalId}}",
    "comment": "Jeu de données utilisé par la réutilisation",
    "linked_dataset_status": "DRAFT"
  }
}

script:pre-request {
  await bru.runRequest("00 Authentification/03-utilisateur");
  if (!bru.getVar("projectUuid") && bru.getProcessEnv("PROJECT_UUID")) { bru.setVar("projectUuid", bru.getProcessEnv("PROJECT_UUID")); }
  if (!bru.getVar("globalId") && bru.getProcessEnv("DATASET_GLOBAL_ID")) { bru.setVar("globalId", bru.getProcessEnv("DATASET_GLOBAL_ID")); }
}

script:post-response {
  if (res.status === 200) { bru.setVar("linkedDatasetUuid", res.body.uuid); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : utilisateur (connexion automatique avant la requête).

  Jeu ouvert : aucune validation du producteur n'est nécessaire.
}
