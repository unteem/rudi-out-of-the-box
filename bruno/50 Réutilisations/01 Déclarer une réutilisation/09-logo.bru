meta {
  name: Déposer le logo
  type: http
  seq: 9
}

post {
  url: {{protocol}}://{{host}}/projekt/v1/projects/{{projectUuid}}/media/LOGO
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file(fichiers/logo.png)
}

script:pre-request {
  await bru.runRequest("00 Authentification/03-utilisateur");
  if (!bru.getVar("projectUuid") && bru.getProcessEnv("PROJECT_UUID")) { bru.setVar("projectUuid", bru.getProcessEnv("PROJECT_UUID")); }
}

tests {
  test("réponse 2xx", function () {
    expect(res.status).to.be.within(200, 299);
  });
}

docs {
  Compte : utilisateur (connexion automatique avant la requête).
}
