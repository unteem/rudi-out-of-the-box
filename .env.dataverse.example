# =========================================
# DATAVERSE ENVIRONMENT VARIABLES
# Example Configuration File
# =========================================
#
# This file contains OPTIONAL environment variables for Dataverse.
# These enable advanced features beyond the basic RUDI deployment.
#
# USAGE:
#   1. Copy this file: cp .env.dataverse.example .env.dataverse.production
#   2. Uncomment and configure the sections you need
#   3. Deploy with: docker compose --env-file .env.dataverse.production \
#                   -f docker-compose-dataverse.yml up -d
#
# SECURITY:
#   - Add .env.dataverse.production to .gitignore
#   - Never commit passwords or API keys to version control
#   - Store sensitive values in a password manager
#
# =========================================

# =========================================
# AWS S3 STORAGE CONFIGURATION
# =========================================
# Use Amazon S3 for file storage instead of local disk
# Useful for: Cloud deployments, scalability, backup
#
# Prerequisites:
#   - AWS account with S3 access
#   - S3 bucket created
#   - IAM credentials with S3 permissions
#
# Documentation: https://guides.dataverse.org/en/latest/installation/config.html#s3-storage

# AWS S3 bucket name for storing dataset files
#aws_bucket_name=rudi-production-datasets

# AWS profile name (from ~/.aws/credentials) or "default"
#aws_s3_profile=default

# AWS S3 endpoint URL (regional)
# Examples:
#   - US East:      https://s3.us-east-1.amazonaws.com
#   - EU West:      https://s3.eu-west-1.amazonaws.com
#   - EU Central:   https://s3.eu-central-1.amazonaws.com
#aws_endpoint_url=https://s3.eu-west-1.amazonaws.com

# Override storage driver (set to 's3' when using S3)
# Note: This requires modifying docker-compose-dataverse.yml
#dataverse_files_storage-driver-id=s3

# =========================================
# MINIO STORAGE CONFIGURATION
# =========================================
# Use MinIO (S3-compatible) for file storage
# Useful for: On-premise S3-compatible storage, data sovereignty
#
# Prerequisites:
#   - MinIO server running
#   - MinIO bucket created
#   - Access key and secret key
#
# Documentation: https://min.io/

# MinIO Configuration - Storage Location 1
#bucketname_1=rudi-datasets
#minio_label_1=Main Storage
#minio_bucket_1=rudi-datasets
#minio_profile_1=minio-prod

# MinIO Configuration - Storage Location 2 (optional, for redundancy)
#bucketname_2=rudi-datasets-backup
#minio_label_2=Backup Storage
#minio_bucket_2=rudi-datasets-backup
#minio_profile_2=minio-backup

# =========================================
# EMAIL (SMTP) CONFIGURATION
# =========================================
# Configure external SMTP for sending emails
# Default: Uses mailhog (testing only)
# Useful for: Production deployments, real email notifications
#
# Prerequisites:
#   - SMTP server credentials
#   - Firewall allows outbound SMTP connections
#
# Common Providers:
#   - Gmail:     smtp.gmail.com:587 (requires app password)
#   - SendGrid:  smtp.sendgrid.net:587
#   - Office365: smtp.office365.com:587
#   - AWS SES:   email-smtp.region.amazonaws.com:587

# SMTP server hostname
# Examples:
#   - Gmail:     smtp.gmail.com
#   - SendGrid:  smtp.sendgrid.net
#   - Mailgun:   smtp.mailgun.org
#   - Custom:    mail.yourdomain.com
#mailhost=smtp.gmail.com

# SMTP port
# Common ports:
#   - 587: TLS/STARTTLS (recommended)
#   - 465: SSL (legacy)
#   - 25:  Unencrypted (not recommended)
#smtp_port=587

# SMTP username (often your email address or API username)
#mailuser=noreply@yourdomain.com

# SMTP password or API key
# Security: Use app-specific passwords for Gmail, API keys for SendGrid
#smtp_password=your-smtp-password-or-api-key

# System email address (sender address for notifications)
# This appears as "From" in emails sent by Dataverse
#system_email=noreply@yourdomain.com

# No-reply email address (for automated emails)
#no_reply_email=no-reply@yourdomain.com

# Socket port (usually leave empty or set to smtp_port)
#socket_port=587

# Mail server type/protocol (usually leave empty for SMTP)
#MAIL_SERVER=smtp

# =========================================
# DOI/PID PROVIDER CONFIGURATION
# =========================================
# Configure Digital Object Identifier (DOI) registration
# Default: Uses fake DOI provider (testing only)
# Useful for: Publishing datasets with persistent identifiers
#
# Supported Providers:
#   - DataCite: Global DOI registration (recommended)
#   - EZID: University of California service
#   - Fake: Testing only (default)
#
# Prerequisites:
#   - Account with DOI provider
#   - DOI prefix/authority assigned to your organization
#   - API credentials
#
# Documentation: https://guides.dataverse.org/en/latest/installation/config.html#persistent-identifiers

# DOI provider type
# Options: datacite, ezid, fake
#doi_provider=datacite

# DOI authority/prefix (assigned by provider)
# Format: 10.XXXXX where XXXXX is your assigned prefix
# Example: 10.12345, 10.5072 (testing), 10.80243
#doi_authority=10.12345

# DataCite API username (your repository ID)
# Format: ORGANIZATION.REPOSITORY
# Example: UNIV.RUDI, CERN.ZENODO
#doi_username=MYORG.RUDI

# DataCite API password
#doi_password=your-datacite-password

# DataCite REST API URL
# Production: https://api.datacite.org
# Testing:    https://api.test.datacite.org
#dataciterestapiurlstring=https://api.datacite.org

# Base URL for DOI resolution (your Dataverse instance URL)
# Example: https://data.yourdomain.com
#baseurlstring=https://dataverse.yourdomain.com

# DOI shoulder (optional suffix after authority)
# Common: FK2/ for fake, empty for production
# Note: Must be configured with your DOI provider
#dataverse_pid_fake_shoulder=

# =========================================
# CONTROLLED VOCABULARY MANAGERS
# =========================================
# External vocabulary services for metadata standards
# Used for: Standardized metadata, controlled vocabularies
#
# CESSDA: Consortium of European Social Science Data Archives
# CLARIN: Common Language Resources and Technology Infrastructure

# CESSDA Vocabulary Service
# Leave empty to disable, or set to service URL
#CESSDA=

# CLARIN Vocabulary Service  
# Leave empty to disable, or set to service URL
#CLARIN=

# Custom Controlled Vocabulary Manager
# URL to your vocabulary service
#CVM_SERVER_NAME=MyVocabService
#CVM_SERVER_URL=https://vocab.yourdomain.com

# =========================================
# FEDERATED SEARCH CONFIGURATION
# =========================================
# Enable federation with other Dataverse instances
# Useful for: Harvesting metadata, distributed search
#
# Documentation: https://guides.dataverse.org/en/latest/admin/harvestclients.html

# Path to JSON file with federated instance configurations
# Format: JSON array of {name, url, apikey} objects
#federated_json_file=/config/federated-dataverses.json

# =========================================
# DATABASE CONFIGURATION
# =========================================
# Advanced database settings (rarely need to change)

# PostgreSQL password (usually not needed - passed via ${DB_DATAVERSE})
# Only set if you want to override the .passwords.env value
#PGPASSWORD=

# Dataverse service host (internal Docker network)
# Only set if using external database or custom network
#DATAVERSE_SERVICE_HOST=

# =========================================
# ADVANCED DATAVERSE SETTINGS
# =========================================
# Additional configuration options
# Most users don't need to modify these

# Webhook script path (for external integrations)
# Default: /opt/payara/triggers/external-services.py
#WEBHOOK=/opt/payara/triggers/external-services.py

# Controlled vocabulary manager endpoint
# Legacy setting, usually leave empty
#cvManager=

# =========================================
# EXAMPLE CONFIGURATIONS
# =========================================

# ─────────────────────────────────────────
# EXAMPLE 1: Production with DataCite + Gmail
# ─────────────────────────────────────────
#
# # DOI Registration (DataCite Production)
# doi_provider=datacite
# doi_username=MYUNIV.RUDI
# doi_password=MyDataCitePassword123!
# doi_authority=10.12345
# dataciterestapiurlstring=https://api.datacite.org
# baseurlstring=https://data.myuniversity.edu
#
# # Email (Gmail with App Password)
# mailhost=smtp.gmail.com
# smtp_port=587
# mailuser=rudi-noreply@myuniversity.edu
# smtp_password=MyGmailAppPassword123
# system_email=rudi-noreply@myuniversity.edu
# no_reply_email=no-reply@myuniversity.edu

# ─────────────────────────────────────────
# EXAMPLE 2: Production with AWS S3 + SendGrid
# ─────────────────────────────────────────
#
# # AWS S3 Storage
# aws_bucket_name=myorg-rudi-production
# aws_s3_profile=default
# aws_endpoint_url=https://s3.eu-west-1.amazonaws.com
#
# # Email (SendGrid)
# mailhost=smtp.sendgrid.net
# smtp_port=587
# mailuser=apikey
# smtp_password=SG.xxxxxxxxxxxxxxxxxxx
# system_email=noreply@myorg.com
# no_reply_email=no-reply@myorg.com
#
# # DOI (DataCite)
# doi_provider=datacite
# doi_username=MYORG.RUDI
# doi_password=DataCitePass123
# doi_authority=10.98765
# dataciterestapiurlstring=https://api.datacite.org
# baseurlstring=https://data.myorg.com

# ─────────────────────────────────────────
# EXAMPLE 3: Testing with DataCite Test Server
# ─────────────────────────────────────────
#
# # DOI Testing (DataCite Test Environment)
# doi_provider=datacite
# doi_username=MYORG.RUDI
# doi_password=TestPassword123
# doi_authority=10.5072
# dataciterestapiurlstring=https://api.test.datacite.org
# baseurlstring=https://test.myorg.com
#
# # Use default mailhog for testing (no email config needed)

# =========================================
# DEPLOYMENT INSTRUCTIONS
# =========================================
#
# STEP 1: Choose your configuration
#   - Copy relevant example above
#   - Uncomment the lines you need
#   - Fill in your actual credentials
#
# STEP 2: Save as production file
#   mv .env.dataverse.example .env.dataverse.production
#   chmod 600 .env.dataverse.production
#
# STEP 3: Add to .gitignore
#   echo ".env.dataverse.production" >> .gitignore
#
# STEP 4: Deploy
#   # Source main environment
#   source .env
#   source .passwords.env
#   
#   # Deploy with Dataverse-specific config
#   docker compose \
#     -f docker-compose-dataverse.yml \
#     -f docker-compose-network.yml \
#     --env-file .env.dataverse.production \
#     up -d
#
# STEP 5: Verify configuration
#   # Check environment variables in container
#   docker exec dataverse env | grep doi_provider
#   docker exec dataverse env | grep aws_bucket_name
#   docker exec dataverse env | grep mailhost
#
# STEP 6: Test functionality
#   # For DOI: Try publishing a dataset
#   # For Email: Check notification emails
#   # For S3: Upload files and verify in S3 console
#
# =========================================
# TROUBLESHOOTING
# =========================================
#
# Variables not being set?
#   - Check file is named .env.dataverse.production
#   - Verify --env-file path is correct
#   - Ensure no syntax errors (no spaces around =)
#   - Check file permissions (chmod 600)
#
# Email not working?
#   - Verify SMTP credentials
#   - Check firewall allows outbound port 587
#   - For Gmail: Use app-specific password, not account password
#   - Check Dataverse logs: docker logs dataverse
#
# DOI registration failing?
#   - Verify DOI provider credentials
#   - Check doi_authority matches your assigned prefix
#   - Ensure baseurlstring is publicly accessible
#   - Check DataCite API status
#
# S3 access denied?
#   - Verify IAM permissions include s3:PutObject, s3:GetObject
#   - Check bucket name and region match
#   - Verify AWS credentials are correct
#   - Check bucket CORS configuration
#
